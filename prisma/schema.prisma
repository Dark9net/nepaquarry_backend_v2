  id            String @id @default(cuid())
  orgId         String
  rateId        String
  tripVehicleId String

  calculatedRate  Decimal @db.Decimal(10, 2)
  internalTotal   Decimal @db.Decimal(10, 2)
  internalTaxable Decimal @db.Decimal(10, 2)
  internalVat     Decimal @db.Decimal(10, 2)
  externalRate    Decimal @db.Decimal(10, 2)

  snapshotVolume    Decimal @db.Decimal(10, 3)
  snapshotBasePrice Decimal @db.Decimal(10, 2)
  snapshotRefVolume Decimal @db.Decimal(10, 3)

  calculatedAt DateTime @default(now())
