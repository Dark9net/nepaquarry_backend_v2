  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org           Organization        @relation(fields: [orgId], references: [id])
  product       MasterProduct       @relation(fields: [productId], references: [id])
  orderByStaff  Staff               @relation("OrderByStaff", fields: [orderByStaffId], references: [id])
  orderToMember OrganizationMember  @relation("OrderToMember", fields: [orderToMemberId], references: [id])
  createdBy     OrganizationMember  @relation("OrderCreatedBy", fields: [createdById], references: [id])
  checkedBy     OrganizationMember? @relation("OrderCheckedBy", fields: [checkedById], references: [id])
