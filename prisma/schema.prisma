// -------------------------------------------Credit Party Model-------------------------------------------
// tables used in creditsales page (creditsales.tsx)
model CreditParty {
  id            String      @id @default(cuid())
  orgId         String
  name          String
  panNo         String?
  address       String?
  contactPerson String?
  contactNo     String?
  balanceType   BalanceType @default(CREDIT)
  creditBalance Decimal     @default(0) @db.Decimal(12, 2)
  isActive      Boolean     @default(true)
  notes         String?     @db.Text
  createdById   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org       Organization       @relation(fields: [orgId], references: [id])
  createdBy OrganizationMember @relation("CreditPartyCreatedBy", fields: [createdById], references: [id])

  rates        CreditPartyRate[]
  transactions CreditTransaction[]

  @@unique([orgId, name])
  @@index([orgId])
  @@index([orgId, isActive])
}

model CreditPartyRate {
  id            String  @id @default(cuid())
  creditPartyId String
  tripVehicleId String
  materialId    String
  ratePerTrip   Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creditParty CreditParty @relation(fields: [creditPartyId], references: [id], onDelete: Cascade)
  tripVehicle TripVehicle @relation(fields: [tripVehicleId], references: [id])
  material    RawMaterial @relation(fields: [materialId], references: [id])

  @@unique([creditPartyId, tripVehicleId, materialId])
  @@index([creditPartyId])
}

model CreditTransaction {
  id            String   @id @default(cuid())
  orgId         String
  creditPartyId String
  reportId      String?
  date          DateTime @db.Date
  tripVehicleId String
  materialId    String
  trips         Int
  rateUsed      Decimal  @db.Decimal(10, 2)
  amount        Decimal  @db.Decimal(12, 2)
  billNo        String?
  notes         String?  @db.Text
  createdById   String
  createdAt     DateTime @default(now())

  org         Organization       @relation(fields: [orgId], references: [id])
  creditParty CreditParty        @relation(fields: [creditPartyId], references: [id])
  report      DailySalesReport?  @relation(fields: [reportId], references: [id], onDelete: SetNull)
  tripVehicle TripVehicle        @relation(fields: [tripVehicleId], references: [id])
  material    RawMaterial        @relation(fields: [materialId], references: [id])
  createdBy   OrganizationMember @relation("CreditTxnCreatedBy", fields: [createdById], references: [id])

  @@index([orgId])
  @@index([orgId, date])
  @@index([orgId, creditPartyId])
  @@index([reportId])
}
