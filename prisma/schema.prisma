  customerDeposit            Decimal @default(0) @db.Decimal(10, 2)
  cashParticular             String?
  cash                       Decimal @default(0) @db.Decimal(10, 2)
  cashReceiveExtraParticular String?
  cashReceiveExtra           Decimal @default(0) @db.Decimal(10, 2)
  onlineTransfer             Decimal @default(0) @db.Decimal(10, 2)
  voidCount                  Int     @default(0)
