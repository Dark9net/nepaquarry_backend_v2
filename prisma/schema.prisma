  @@unique([orgId, name])
  @@index([orgId])
  @@index([orgId, isActive])
}

// -------------------------------------------Material Rate Model-------------------------------------------
model MaterialRate {
  id                 String   @id @default(cuid())
  orgId              String
  materialId         String
  referenceVehicleId String
  basePrice          Decimal  @db.Decimal(10, 2)
  setById            String
  setAt              DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org              Organization       @relation(fields: [orgId], references: [id])
  material         RawMaterial        @relation(fields: [materialId], references: [id])
  referenceVehicle TripVehicle        @relation("ReferenceVehicle", fields: [referenceVehicleId], references: [id])
  setBy            OrganizationMember @relation("RateSetBy", fields: [setById], references: [id])

  details MaterialRateDetail[]

  @@unique([orgId, materialId, referenceVehicleId])
  @@index([orgId])
  @@index([orgId, materialId])
}

