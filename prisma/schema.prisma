// -------------------------------------------Orders Model-------------------------------------------
// this belongs to orders page (orders.tsx)
model Orders {
  id        String   @id @default(cuid())
  orgId     String
  productId String
  date      DateTime @db.Date

  productCode String
  productName String
  size        String?

  quantity     Int
  details      String? @db.Text
